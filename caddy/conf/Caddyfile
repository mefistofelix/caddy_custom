{
  default_bind tcp4/0.0.0.0
  admin off
  auto_https disable_redirects
  on_demand_tls {
    ask http://127.0.0.1:19000/caddy_on_demand_tls
  }
  debug
  http_port {$CADDY_HTTP_PORT:80}
  https_port {$CADDY_HTTPS_PORT:443}
  log default {
    format console
    #output file {$CADDY_LOG_PATH:/var/log/caddy/caddy.log} {
    #  roll_uncompressed
    #  roll_keep 0
    #  roll_size 1MiB
    #  roll_keep_days 0
    #}
  }

  order proxy_cache before reverse_proxy
}




http:// https:// {
  #bind {
  #  {$CADDY_HTTP_BIND:http://:80}
  #  {$CADDY_HTTPS_BIND:http://:443}
  #}
  tls {
    on_demand
  }
  encode {
    gzip
  }
  vars {
    roots_base {$CADDY_ROOT_BASE:/var/www}
  }
  @ip_host {
    header_regexp Host ^.*?\d+\.\d+\.\d+\.\d+([\.\w]+)?(:\d+)?$
  }
  @full_host {
    file {
      root {vars.roots_base}
      try_files {http.request.host}/
    }
  }
  @full_sldtld {
    file {
      root {vars.roots_base}
      try_files {http.request.host.labels.1}.{http.request.host.labels.0}/
    }
  }
  @full_sld {
    file {
      root {vars.roots_base}
      try_files {http.request.host.labels.1}/
    }
  }
  vars @full_host {
    root_name "{http.request.host}"
  }
  vars @full_sldtld {
    root_name "{http.request.host.labels.1}.{http.request.host.labels.0}"
  }
  vars @full_sld {
    root_name "{http.request.host.labels.1}"
  }
  vars @ip_host {
    root_name "main"
  }
  root * {vars.roots_base}/{vars.root_name}/public
  encode zstd gzip
  header {
    -Server
  }
  @static {  
    path_regexp \.(jpg|jpeg|png|webp|gif|avif|ico|svg|css|js|gz|eot|ttf|otf|woff|woff2|pdf)$  
  }  
  header @static Cache-Control "max-age=31536000,public,immutable"
  @htpasswd_exists {
    file /.htpasswd
  }
  basicauth @htpasswd_exists {
    example-user REPLACE_WITH_BCRYPT_HASH
  }
  file_server {
    index index.html
    hide */.*
  }
  try_files /offline.html {path}
  route {
    @canonicalPath {
      file {path}/index.php
      not path */
    }
    redir @canonicalPath {http.request.orig_uri.path}/ 308
    @indexFiles file {
      try_files {path} {path}/index.php index.php
      split_path .php
    }
    rewrite @indexFiles {file_match.relative}
    @phpFiles path *.php
    proxy_cache
    reverse_proxy @phpFiles unix//run/php-fpm-{vars.root_name}.sock {
      transport fastcgi {
        split .php
      }
    }
  }
}

