#!/usr/bin/env bash

#EXTERNAL COMMANDS USED BY THIS BUILD SCRIPT: wget mkdir tar

shopt -s expand_aliases
shopt -s globstar
shopt -s dotglob
#alias xapt='DEBIAN_FRONTEND=noninteractive apt -y -qq -o Dpkg::Options::='--force-confdef' -o Dpkg::Options::='--force-confold' -o APT::Get::Always-Include-Phased-Updates=true'

#PURE BASH FUNCTION TO DETERMINE THE CURRENT BASH SCRIPT DIRECTORY ABSOLUTE PATH:
get_script_dir() {
  local wdir
  local scriptdir
  wdir="$PWD"; [ "$PWD" = "/" ] && wdir=""
  case "$0" in
    /*) scriptdir="${0}";;
    *) scriptdir="$wdir/${0#./}";;
  esac
  scriptdir="${scriptdir%/*}"
  REPLY=$scriptdir
}

get_script_dir
script_dir=$REPLY
dname=${script_dir##*/}
#echo $script_dir
#mkdir -p $script_dir/bin

#xapt install golang

#install golang locally
url="https://go.dev/dl/go1.22.2.linux-amd64.tar.gz"
url_file=${url##*/}
if [[ ! -e $script_dir/build/golang ]]
then
  mkdir -p $script_dir/build
  if [[ ! -e $script_dir/build/$url_file ]]
  then
    echo "downloading golang..."
    wget -q $url -O $script_dir/build/$url_file
    if [ $? -ne 0 ]; then { echo "compiler download failed, aborting." ; exit 1; } fi
  fi
  echo "extracting golang..."
  mkdir -p $script_dir/build/golang
  tar --strip-components=1 -xf $script_dir/build/$url_file -C $script_dir/build/golang
  #mv $script_dir/$url_dir $script_dir/golang
  if [ $? -ne 0 ]; then { echo "compiler extraction failed, aborting." ; exit 1; } fi
fi

#setup golang env
#https://stackoverflow.com/questions/24069664/what-does-go-install-do
#GOARCH=amd64
#GOOS=linux
export CGO_ENABLED=0
#GOBIN=
export GOPATH=$script_dir/build/golang
#GOROOT=
#GOMODCACHE=$script_dir/build/golang/cache
#$script_dir/build/golang/bin/go env
#exit

#install xcaddy
$script_dir/build/golang/bin/go install github.com/caddyserver/xcaddy/cmd/xcaddy@latest

#xcaddy wants go cmd in path
export PATH=$PATH:$script_dir/build/golang/bin/

#build caddy
#cd $script_dir/src
#$script_dir/build/golang/bin/xcaddy list-modules
#$script_dir/build/golang/bin/xcaddy build master --with github.com/ducktype/caddy_proxy_cache=./src
$script_dir/build/golang/bin/xcaddy build v2.7.6 --with github.com/caddyserver/forwardproxy@master --with github.com/ducktype/caddy_proxy_cache=./src
if [ $? -ne 0 ]; then { echo "compilation failed, aborting." ; exit 1; } fi

./caddy list-modules

mkdir -p $script_dir/caddy_data
export XDG_CONFIG_HOME=$script_dir/caddy_data
export XDG_DATA_HOME=$script_dir/caddy_data
export CADDY_HTTP_PORT=2080
export CADDY_HTTPS_PORT=20443
./caddy run -c $script_dir/Caddyfile

#find /var/lib/caddy/.local/share/caddy/proxy_cache -type f -mtime +1 -exec rm -rf {} \;
#mv /usr/bin/caddy /usr/bin/caddy.old
#cp caddy /usr/bin
#tail -f /var/log/caddy/caddy.log
#ll /var/lib/caddy/.local/share/caddy
#du -h /var/lib/caddy/.local/share/caddy/proxy_cache/
#service caddy stop
#service caddy start